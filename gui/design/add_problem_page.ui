QRadioButton {
	font-size:16px;
	font-family: &quot;Gill Sans&quot;, sans-sarif;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
	border-radius: 10px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid rgb(164, 142, 202);
    background-color: transparent;
}

